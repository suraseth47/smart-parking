# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าจริง (ห้าม commit .env)

# ที่อยู่ของระบบ (ยังไม่มีโดเมน -> Caddy ออกใบรับรอง HTTPS เองตาม IP)
#   หน้าบ้าน  http://PUBLIC_IP:8008   หลังบ้าน  https://PUBLIC_IP:ADMIN_PUBLIC_PORT/admin
PUBLIC_IP=125.26.22.145
LAN_IP=192.168.200.196
ADMIN_PUBLIC_PORT=8010
# พอร์ตบน Server (MikroTik ต้อง forward มาที่พอร์ตนี้)
FRONT_PORT=8080
ADMIN_PORT=8443
# รับจาก reverse proxy ในวง LAN ที่ถือใบรับรองโดเมน (เช่น https://parking.naslink.net) — ห้าม forward ออกเน็ต
PROXY_PORT=8081

# ใบรับรอง SSL ที่ถูกต้อง (TOR 5.1) — ดู README หัวข้อ HTTPS
# ที่อยู่หลังบ้านที่ใช้สร้างลิงก์คำเชิญ เมื่อมีโดเมนแล้ว:
# PUBLIC_ADMIN_URL=https://parking.naslink.net
# แบบ ข. (Caddy ขอใบรับรองเอง ต้องได้พอร์ต 80/443):
# DOMAIN=parking.example.go.th
# ACME_EMAIL=it@example.go.th

# ชื่อระบบและหน่วยงาน (หัวเว็บและแถบเมนูหลังบ้าน)
SYSTEM_TITLE=ระบบบริหารจัดการที่จอดรถอัจฉริยะ
ORG_NAME=เทศบาลเมืองสระบุรี

# ชื่อสถานที่แสดงบนเว็บสาธารณะ
SITE_NAME_TH=ลานจอดรถ ตัวอย่าง
SITE_NAME_EN=Sample Parking

# เซ็น session cookie (สุ่มด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# เข้ารหัสรหัสผ่านกล้องใน DB (สุ่มด้วย: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=change-me

TZ=Asia/Bangkok

# โมเดล AI ในโฟลเดอร์ models/ (ไม่ตั้ง = yolox_s.onnx) ดูวิธีเลือกใน models/README.md
# DETECTOR_MODEL=yolox_m.onnx

# จำกัด IP ที่เข้าหลังบ้านได้ (ไม่บังคับ) -> ตั้งที่หน้า /admin/settings
# หลัง login แทน ไม่ได้ตั้งผ่าน .env

# ส่งอีเมลคำเชิญ (ไม่บังคับ — ตั้งจากหน้าเว็บ ตั้งค่าระบบ → อีเมลและลิงก์คำเชิญ ได้ ค่าในหน้าเว็บมีผลก่อน)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password-16-ตัว
# SMTP_FROM=NASLINK Smart Parking <you@gmail.com>

# สำรองฐานข้อมูลอัตโนมัติ (worker ทำให้ทุกวัน) — ไม่ตั้งก็ได้
# BACKUP_HOUR=3
# BACKUP_KEEP=14
